      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load bay_area_modeling_table.csv or other files to inspect\n",
        "df = pd.read_csv(\"bay_area_modeling_table.csv\", low_memory=False)\n",
        "\n",
        "print(\"Columns:\", df.columns.tolist())\n",
        "print(\"\\nUnique campuses in 2025:\", df[df['fall_term'] == 2025]['campus'].unique())\n",
        "\n",
        "# Filter for fall 2025\n",
        "df_2025 = df[df['fall_term'] == 2025]\n",
        "\n",
        "# Sum of applicants for non-Universitywide campuses vs Universitywide\n",
        "sum_campus_apps = df_2025[df_2025['campus'] != 'Universitywide']['applicants'].sum()\n",
        "uwide_apps = df_2025[df_2025['campus'] == 'Universitywide']['applicants'].sum()\n",
        "\n",
        "print(\"Sum of campus applicants:\", sum_campus_apps)\n",
        "print(\"Universitywide applicants:\", uwide_apps)\n",
        "print(\"Ratio (Average campuses applied per applicant):\", sum_campus_apps / uwide_apps)"
      ]
