        "import pandas as pd\n",
        "\n",
        "df = pd.read_csv(\"bay_area_modeling_table.csv\", low_memory=False)\n",
        "ucla_2025 = df[(df['fall_term'] == 2025) & (df['campus'] == 'Los Angeles')]\n",
        "print(\"Applicants:\", ucla_2025['applicants'].sum())\n",
        "\n",
        "# Is there any subset of applicants summing to ~18285?\n",
        "print(\"Non-null admit_rate apps:\", ucla_2025[ucla_2025['admit_rate'].notnull()]['applicants'].sum())\n",
        "print(\"Non-null admits apps:\", ucla_2025[ucla_2025['admits'].notnull()]['applicants'].sum())\n",
