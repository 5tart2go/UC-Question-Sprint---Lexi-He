    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "df = pd.read_csv(\"uc_admissions_summary_by_ethnicity.csv\", low_memory=False)\n",
        "\n",
        "# Filter\n",
        "df_2025 = df[(df['fall_term'] == 2025) & (df['entrant_level'] == 'freshman') & (df['campus'] != 'Systemwide')]\n",
        "\n",
        "campuses = df_2025['campus'].unique()\n",
        "\n",
        "results = []\n",
        "for campus in campuses:\n",
        "    # White\n",
        "    w_app = df_2025[(df_2025['campus'] == campus) & (df_2025['ethnicity'] == 'White') & (df_2025['count_type'] == 'App')]['n'].sum()\n",
        "    w_adm = df_2025[(df_2025['campus'] == campus) & (df_2025['ethnicity'] == 'White') & (df_2025['count_type'] == 'Adm')]['n'].sum()\n",
        "    w_rate = w_adm / w_app if w_app > 0 else 0\n",
        "\n",
        "    # Hispanic/Latino(a)\n",
        "    h_app = df_2025[(df_2025['campus'] == campus) & (df_2025['ethnicity'] == 'Hispanic/Latino(a)') & (df_2025['count_type'] == 'App')]['n'].sum()\n",
        "    h_adm = df_2025[(df_2025['campus'] == campus) & (df_2025['ethnicity'] == 'Hispanic/Latino(a)') & (df_2025['count_type'] == 'Adm')]['n'].sum()\n",
        "    h_rate = h_adm / h_app if h_app > 0 else 0\n",
        "\n",
        "    results.append({\n",
        "        'Campus': campus,\n",
        "        'White App': w_app,\n",
        "        'White Adm': w_adm,\n",
        "        'White Rate': w_rate,\n",
        "        'H/L App': h_app,\n",
        "        'H/L Adm': h_adm,\n",
        "        'H/L Rate': h_rate,\n",
        "        'White > H/L': w_rate > h_rate\n",
        "    })\n",
        "\n",
        "res_df = pd.DataFrame(results)\n",
        "print(res_df)\n",
        "print(\"\\nNumber of campuses where White admit rate > Hispanic/Latino(a) admit rate:\", res_df['White > H/L'].sum())"
      ],
      "metadata": {
        "id": "Gby3yTOKjxku"
      },
